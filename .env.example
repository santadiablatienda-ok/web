# ============================================
# SANTA DIABLA — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to the repository.

# --------------------------------------------
# App
# --------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------
# Supabase
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --------------------------------------------
# Mercado Pago (Checkout Pro)
# Access Token de la app en developers.mercadopago.com
# --------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=

# Secreto compartido con las funciones RPC de Supabase (set_order_mp_preference,
# confirm_order_payment) que permiten a las rutas de pago actualizar pedidos
# sin necesitar la service_role key. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y guardar el mismo valor en private.app_secrets (key = 'mp_db_secret') en Supabase.
MP_DB_SECRET=
